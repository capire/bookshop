### CatalogService.read Books
GET {{cats}}/Books?$select=ID,title,author&$where=author%20like%20%27%25Bro%25%27


### Same with JSON CQL and positional bindings
POST {{cats}}
Content-Type: application/json

{
  "cql": "SELECT from Books { ID, title, author } where author like ?",
  "args": ["%Bro%"]
}


### CatalogService.read Books with filtering, ordering, paging, and total count
GET {{cats}}/Books?$select=ID,title,stock&$filter=stock%20%3E%200&$orderby=title&$top=10&$skip=0
X-Total-Count: true


### Same with POST
POST {{cats}}
Content-Type: text/plain

SELECT from Books [where author like '%Bro%'] {
  ID, title, author
}


### CatalogService.submitOrder
POST {{cats}}/submitOrder
Content-Type: application/json
Authorization: Basic bob:

{ "book": 201, "quantity": 1 }

### AdminService.read Authors
POST {{admin}}
Content-Type: text/plain

SELECT from Authors {
  ID, name, books {
    ID, title,
    genre.name as genre
  }
} where books.genre.name = 'Drama'


### AdminService.read Authors with direct CQN
POST {{admin}}
Content-Type: application/json

{ "SELECT": {
  "from": { "ref": [ "Authors" ] },
  "columns": [
    { "ref": [ "ID" ] },
    { "ref": [ "name" ] },
    { "ref": [ "books" ], "expand": [
      { "ref": [ "ID" ] },
      { "ref": [ "title" ] },
      { "ref": [ "genre", "name" ], "as": "genre" }
    ]}
  ]
}}


### AdminService.read one Book with wrapped CQN
POST {{admin}}
Content-Type: application/json

{ "cqn": { "SELECT": {
  "one": true,
  "from": { "ref": ["Books"] },
  "columns": [{ "ref": ["ID"] }, { "ref": ["title"] }],
  "where": [{ "ref": ["ID"] }, "=", { "val": 201 }]
}}}


### AdminService.upsert Books with CQL
POST {{admin}}
Content-Type: text/plain

UPSERT into Books {
  ID: 311, title: 'T1', author: { ID: 101 }
},
{
  ID: 312, title: 'T2', author: { ID: 107 }
}

### AdminService.insert Books with CQN
POST {{admin}}
Content-Type: application/json

{ "INSERT": {
  "into": { "ref": ["Books"] },
  "entries": [
    { "ID": 313, "title": "T1", "author": {"ID":101} },
    { "ID": 314, "title": "T2", "author": {"ID":107} }
  ]
}}

### AdminService.update Books
POST {{admin}}
Content-Type: application/json

{ "UPDATE": {
  "entity": { "ref": ["Books"] },
  "data": { "title": "T1", "author_ID": 101 },
  "where": [{ "ref": ["ID"] }, "=", { "val": 313 }]
}}


### AdminService.insert Authors
POST {{admin}}
Content-Type: text/plain

INSERT into Authors {
  ID: 201, name: 'George Orwell',
  dateOfBirth: '1903-06-25', dateOfDeath: '1950-01-21',
  placeOfBirth: 'Motihari, India', placeOfDeath: 'London, England'
}



###
GET {{admin}}/Books/201?$select=ID,stock

###
POST {{admin}}
Content-Type: text/plain

SELECT one from Books { ID, stock } where ID = 201

###
PATCH {{admin}}/Books/201
Content-Type: application/json

{ "stock": 22 }

###
POST {{admin}}
Content-Type: text/plain

UPDATE Books[201] with { stock: 33 }

###
POST {{admin}}
Content-Type: text/plain

SELECT from Authors {
  ID, name, dateOfBirth, dateOfDeath,
  years_between(dateOfBirth, dateOfDeath) as lifespan,
  placeOfBirth, placeOfDeath,
  count(books.ID) as totalBooks,
  sum(books.stock) as totalStock,
  round(avg(books.price)) as avgPrice,
  min(books.price) as cheapest,
  max(books.price) as priciest
}
WHERE
  books.stock > 30
  AND dateOfDeath != null
GROUP BY
  ID, name, dateOfBirth, dateOfDeath, placeOfBirth, placeOfDeath
ORDER BY
  totalBooks desc, totalStock desc
LIMIT 8

###
POST {{admin}}
Content-Type: text/plain

SELECT from Authors {
  ID, name, placeOfBirth, dateOfBirth, dateOfDeath,
  years_between(dateOfBirth, dateOfDeath) as lifespan,
  books [
    where price > 9
    order by stock desc
    limit 3
  ] {
    ID, title, price, stock, currency {
      code, symbol, name, minorUnit
    },
    genre {
      name, descr, parent {
        name, parent {
          name
        }
      }
    }
  }
}
WHERE exists books [stock > 30] AND dateOfDeath != null


